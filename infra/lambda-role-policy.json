{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvoke",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/${EmbeddingModelId}",
        "arn:aws:bedrock:us-east-1:${AccountId}:inference-profile/${TextModelId}",
        "arn:aws:bedrock:us-east-1:${AccountId}:inference-profile/${StyleModelId}",
        "arn:aws:bedrock:us-east-1:${AccountId}:inference-profile/${VisionModelId}",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-east-1:${AccountId}:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    {
      "Sid": "ListRawPosts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${BucketName}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw-posts/*",
            "users/*",
            "generated-posts/*"
          ]
        }
      }
    },
    {
      "Sid": "S3Prefixes",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${BucketName}/raw-posts/*",
        "arn:aws:s3:::${BucketName}/embeddings/*",
        "arn:aws:s3:::${BucketName}/vector-index/*",
        "arn:aws:s3:::${BucketName}/style-profile/*",
        "arn:aws:s3:::${BucketName}/images/*",
        "arn:aws:s3:::${BucketName}/generated-posts/*",
        "arn:aws:s3:::${BucketName}/prompt-templates/*",
        "arn:aws:s3:::${BucketName}/metadata/*",
        "arn:aws:s3:::${BucketName}/users/*"
      ]
    },
    {
      "Sid": "DeleteUserObjects",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::${BucketName}/users/_auth/login/*",
        "arn:aws:s3:::${BucketName}/users/u_*"
      ]
    },
    {
      "Sid": "LogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:${AccountId}:log-group:/aws/lambda/${FunctionName}:*"
    },
    {
      "Sid": "ReadToken",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:us-east-1:${AccountId}:parameter${MablopTokenSsmPath}",
        "arn:aws:ssm:us-east-1:${AccountId}:parameter${MablopSigningSecretSsmPath}",
        "arn:aws:ssm:us-east-1:${AccountId}:parameter${MablopBraveKeySsmPath}",
        "arn:aws:ssm:us-east-1:${AccountId}:parameter${MablopSerpKeySsmPath}"
      ]
    }
  ]
}
